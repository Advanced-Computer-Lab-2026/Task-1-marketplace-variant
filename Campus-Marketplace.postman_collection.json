          ]
        },
        {
          "name": "GET malformed id -> 400 (not 500)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/listings/abc",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "listings",
                "abc"
              ]
            },
            "description": "Guarded with ObjectId.isValid(). Without that guard Mongoose throws a CastError and this would be a 500."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
