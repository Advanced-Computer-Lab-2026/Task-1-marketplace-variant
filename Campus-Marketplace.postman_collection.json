{
  "info": {
    "name": "Campus Marketplace API (Task 1 variant)",
    "description": "Listings CRUD with SOFT DELETE.\n\nRun the folders top to bottom the first time: \"1. Setup\" creates a seller and a listing and stores their ids in the collection variables {{sellerId}} and {{listingId}}, which every later request reuses.\n\nThe key behaviour: DELETE /api/listings/:id does NOT remove the document. It sets status=\"removed\", and GET endpoints hide removed listings unless you pass ?includeRemoved=true.\n\nServer must be running: npm run dev inside server/.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:4000/api",
      "type": "string"
    },
    {
      "key": "sellerId",
      "value": "",
      "type": "string"
    },
    {
      "key": "listingId",
      "value": "",
      "type": "string"
    },
    {
      "key": "soldListingId",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "0. Health",
      "item": [
        {
          "name": "GET health",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "health"
              ]
            },
            "description": "Server is up."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "1. Setup (run these first)",
      "item": [
        {
          "name": "POST create a seller",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/users",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "users"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Test Seller\",\n  \"email\": \"seller_{{$timestamp}}@campus-example.com\",\n  \"password\": \"secret123\"\n}"
            },
            "description": "Creates a User so listings have a seller to reference. The email uses {{$timestamp}} so you can re-send this without a 409 duplicate-email error."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 201\", () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set(\"sellerId\", pm.response.json().user.id);",
                  "console.log(\"sellerId =\", pm.collectionVariables.get(\"sellerId\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "POST create a listing",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/listings",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "listings"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Calculus textbook\",\n  \"description\": \"8th edition, barely used\",\n  \"price\": 250,\n  \"category\": \"textbooks\",\n  \"condition\": \"like-new\",\n  \"seller\": \"{{sellerId}}\"\n}"
            },
            "description": "Uses {{sellerId}} from the previous request. Note the response: status defaults to \"active\", condition to \"used\"."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 201\", () => pm.response.to.have.status(201));",
                  "const l = pm.response.json().listing;",
                  "pm.test(\"status defaults to active\", () => pm.expect(l.status).to.eql(\"active\"));",
                  "pm.collectionVariables.set(\"listingId\", l.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "POST create a second listing (for the sold demo)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/listings",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "listings"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Desk lamp\",\n  \"price\": 40,\n  \"seller\": \"{{sellerId}}\"\n}"
            },
            "description": "No category or condition sent, so the schema defaults kick in: category=\"other\", condition=\"used\"."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 201\", () => pm.response.to.have.status(201));",
                  "const l = pm.response.json().listing;",
                  "pm.test(\"category defaults to other\", () => pm.expect(l.category).to.eql(\"other\"));",
                  "pm.collectionVariables.set(\"soldListingId\", l.id);"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "2. Read",
      "item": [
        {
          "name": "GET all listings",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/listings",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "listings"
              ]
            },
            "description": "Default list. Removed listings are excluded. seller is populated with name/email only - never the password hash."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"no removed listings in the default list\", () =>",
                  "  pm.expect(pm.response.json().listings.every(l => l.status !== \"removed\")).to.be.true);"
                ]
              }
            }
          ]
        },
        {
          "name": "GET one listing",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/listings/{{listingId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "listings",
                "{{listingId}}"
              ]
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "GET filter by category",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/listings?category=textbooks",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "listings"
              ],
              "query": [
                {
                  "key": "category",
                  "value": "textbooks"
                }
              ]
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "GET filter by status (active)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/listings?status=active",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "listings"
              ],
              "query": [
                {
                  "key": "status",
                  "value": "active"
                }
              ]
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "GET including removed",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/listings?includeRemoved=true",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "listings"
              ],
              "query": [
                {
                  "key": "includeRemoved",
                  "value": "true"
                }
              ]
            },
            "description": "The opt-in. Now soft-deleted listings appear."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "GET only removed",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/listings?status=removed",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "listings"
              ],
              "query": [
                {
                  "key": "status",
                  "value": "removed"
                }
              ]
            },
            "description": "An explicit ?status= wins over the default filter, so this is how you audit what was deleted."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "3. Update",
      "item": [
        {
          "name": "PATCH update a listing",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/listings/{{listingId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "listings",
                "{{listingId}}"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"price\": 199,\n  \"description\": \"Price dropped\"\n}"
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"price updated\", () => pm.expect(pm.response.json().listing.price).to.eql(199));"
                ]
              }
            }
          ]
        },
        {
          "name": "PATCH mark as sold",
          "request": {
            "method": "PATCH",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/listings/{{soldListingId}}/sold",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "listings",
                "{{soldListingId}}",
                "sold"
              ]
            },
            "description": "Stretch goal: takes NO body, so price/category cannot be edited in the same request that marks it sold. Sold listings still appear in the default GET - only removed ones are hidden."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"status is sold\", () => pm.expect(pm.response.json().listing.status).to.eql(\"sold\"));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "4. SOFT DELETE (the point of this variant)",
      "item": [
        {
          "name": "DELETE a listing",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/listings/{{listingId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "listings",
                "{{listingId}}"
              ]
            },
            "description": "Does NOT remove the document from MongoDB. Sets status=\"removed\" and returns the updated listing."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"status is removed\", () => pm.expect(pm.response.json().listing.status).to.eql(\"removed\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "GET all - deleted one is GONE",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/listings",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "listings"
              ]
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 200\", () => pm.response.to.have.status(200));",
                  "const id = pm.collectionVariables.get(\"listingId\");",
                  "pm.test(\"removed listing is hidden\", () =>",
                  "  pm.expect(pm.response.json().listings.some(l => l.id === id)).to.be.false);"
                ]
              }
            }
          ]
        },
        {
          "name": "GET all?includeRemoved=true - it is STILL THERE",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/listings?includeRemoved=true",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "listings"
              ],
              "query": [
                {
                  "key": "includeRemoved",
                  "value": "true"
                }
              ]
            },
            "description": "Proof the document was never deleted, only hidden."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 200\", () => pm.response.to.have.status(200));",
                  "const id = pm.collectionVariables.get(\"listingId\");",
                  "pm.test(\"removed listing still exists in the DB\", () =>",
                  "  pm.expect(pm.response.json().listings.some(l => l.id === id)).to.be.true);"
                ]
              }
            }
          ]
        },
        {
          "name": "GET one removed -> 404",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/listings/{{listingId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "listings",
                "{{listingId}}"
              ]
            },
            "description": "Same rule as the list route: invisible by default."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 404\", () => pm.response.to.have.status(404));"
                ]
              }
            }
          ]
        },
        {
          "name": "GET one removed with opt-in -> 200",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/listings/{{listingId}}?includeRemoved=true",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "listings",
                "{{listingId}}"
              ],
              "query": [
                {
                  "key": "includeRemoved",
                  "value": "true"
                }
              ]
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "PATCH a removed listing -> 404",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/listings/{{listingId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "listings",
                "{{listingId}}"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"price\": 5\n}"
            },
            "description": "A removed listing cannot be edited, and it 404s exactly like a missing one."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 404\", () => pm.response.to.have.status(404));"
                ]
              }
            }
          ]
        },
        {
          "name": "PATCH sold on a removed listing -> 409",
          "request": {
            "method": "PATCH",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/listings/{{listingId}}/sold",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "listings",
                "{{listingId}}",
                "sold"
              ]
            },
            "description": "You cannot sell something that was taken down."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 409\", () => pm.response.to.have.status(409));"
                ]
              }
            }
          ]
        },
        {
          "name": "DELETE again -> 200 (idempotent)",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/listings/{{listingId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "listings",
                "{{listingId}}"
              ]
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        }
      ]
    },
